@startuml
!include <C4/C4_Context>

' Настройка отображения (опционально)
LAYOUT_WITH_LEGEND()

title Контекстная диаграмма CLI-Graphics движка (C4 Model - Level 1)

' Акторы (Пользователи)
Person(user, "Пользователь", "Взаимодействует с интерфейсом приложения через терминал, нажимает клавиши (Tab, Enter, буквы).")

' Основная система
System(cli_app, "CLI-Graphics Application", "Консольное графическое приложение, построенное на базе собственного TUI-движка на Go. Управляет фокусом, буфером экрана и рендерингом виджетов.")

' Внешние системы / Окружение
System_Ext(terminal, "Эмулятор терминала (ОС)", "Интерпретирует ANSI-последовательности, отрисовывает символы на экране, передает raw-потоки ввода stdin/stdout.")

' Связи между элементами
Rel(user, terminal, "Физически взаимодействует (ввод-вывод)", "Клавиатура / Монитор")
Rel(terminal, cli_app, "Передает raw-байты нажатых клавиш (stdin)", "Поток байт / ANSI Esc")
Rel(cli_app, terminal, "Отправляет буфер кадра для отрисовки (stdout)", "ANSI escape-коды (\u001B[H)")

@endum
